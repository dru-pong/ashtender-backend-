# Copy to .env and fill in. Nothing here has a usable default in production.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Accra
DJANGO_LOG_LEVEL=INFO
DJANGO_MEDIA_ROOT=/var/lib/ashtender/media

# --- Postgres ---
# pg_trgm is required in production: register company names never match
# tenant-entered legal names exactly, and an exact-match lookup would report a
# valid classification as absent. Enable it once per database:
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
POSTGRES_DB=ashtender
POSTGRES_USER=ashtender
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# --- LLM gateway ---
# Any OpenAI-compatible endpoint. Retargeting the whole system at a different
# provider is this variable plus an admin edit to ModelRoute rows.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=300
LLM_CACHE_ENABLED=1
# Where document images are actually processed. Sending them off-shore is a
# cross-border transfer of personal data and must be declared to the Data
# Protection Commission at registration (Act 843 s.27(1)). See docs/DPC.md.
LLM_PROVIDER_JURISDICTION=US

# --- Eligibility engine ---
# A tender value within this fraction of a financial-class cap yields UNKNOWN
# rather than FAIL, because the published cap figures are themselves
# unconfirmed by more than this margin.
ELIGIBILITY_CAP_BOUNDARY_FRACTION=0.15
ELIGIBILITY_FINANCIAL_YEAR_LOOKBACK=5
ELIGIBILITY_PAST_PROJECT_LOOKBACK_YEARS=5

# --- PayerScore publication floor ---
# Nothing is published until BOTH are met. A median over one firm's contracts
# is that firm's confidential payment history with an aggregate label on it.
PAYER_SCORE_MIN_CONTRACTS=5
PAYER_SCORE_MIN_TENANTS=3
